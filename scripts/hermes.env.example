# Hermes secrets —— 复制到容器内 /etc/hermes/hermes.env，chmod 600，不要进 git
# 只填你实际用的那个推送通道即可

# 卡片显示的主机名
HOST_LABEL=op8t-lxc-ubuntu

# 推送通道：ntfy | telegram | bark | webhook | stdout
PUSH_CHANNEL=ntfy

# --- ntfy（推荐，国内可达、无需翻墙；topic 起个别人猜不到的）---
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=op8t-hermes-改成你自己的随机串

# --- telegram（国内常被墙，手机得能直连或走代理）---
# TG_BOT_TOKEN=123456:AA...
# TG_CHAT_ID=你的chat_id

# --- bark（iOS）---
# BARK_URL=https://api.day.app/你的key

# --- 自建 webhook ---
# WEBHOOK_URL=https://your.domain/hook

# 日志目录
HERMES_LOG_DIR=/var/log/hermes
